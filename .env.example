# Copy to .env and fill in real values. .env is gitignored - never commit it.
# Prod servers have their own .env in DEPLOY_APP_DIR; deploy-prod.sh only syncs dist/ and never touches it.

# Node
NODE_ENV=development

# App: api | microservice | worker  (pm2 sets these per process on prod, see ecosystem.config.js)
APP_TYPE=api
API_PORT=3005
LOGGER=1
# LOGGER_INLINE=1

# Worker (APP_TYPE=worker)
# data-migration (default) | payment-migration
WORKER_TYPE=
WORKER_INTERVAL=1000
WORKER_INTERVAL_TIME=
MIGRATION_RECORDS_COUNT=100
MIGRATION_COLLECTION_NAMES=

# Database
MONGODB_URL='mongodb://user:pass@host:27017/lcm?authSource=admin'
MONGODB_VOICE_URL='mongodb://user:pass@host:27017/voice?authSource=admin'
MSSQLDB_URL='Server=host,1433;Database=db;User Id=user;Password=pass;Encrypt=false'

# Queue
RABBITMQ_URL=amqp://user:pass@host:5672
# lcm-file | lcm-sync
RABBITMQ_QUEUE=lcm-file

# Auth
JWT_SECRET=
JWT_ALGORITHIM=HS256
JWT_EXPIRES_IN=10h
APP_ID=
APP_SECRET=
APP_ROLE=
SIMEDGE_APP_USER=
SIMEDGE_APP_PASS=

# External services
STORAGE_API_ROOT_URL=
VOICE_API_ROOT_URL=
VOICE_API_BASIC_AUTH=

# ---- Deploy (read only by deploy-prod.sh and scripts/check-status.sh) ----
DEPLOY_HOSTS=10.10.0.70,10.10.0.71,10.10.0.72
DEPLOY_SSH_USER=root
DEPLOY_SSH_PORT=22
DEPLOY_APP_DIR=/root/apps/lcm-service
# Restarted on every deploy
DEPLOY_PM2_PROCESSES="lcm-ms-file lcm-api lcm-api1 lcm-api2"
# Long-running sync/worker processes: restarted only with --quiet (quiet hours)
DEPLOY_PM2_QUIET_PROCESSES="lcm-ms-sync lcm-wrk"
# Ports of lcm-api, lcm-api1, lcm-api2 (ecosystem.config.js) - checked with GET / after restart
DEPLOY_API_PORTS=3005,3105,3205
DEPLOY_PUBLIC_URL=https://api.hydrabyte.co/lcm
DEPLOY_BACKUP_KEEP=5
