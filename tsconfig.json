{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    
    // Gradually enabled strict options for LCM service code quality
    "strict": false,              // Master strict flag - will enable gradually
    "strictNullChecks": false,    // Temporarily disabled for build success - will re-enable gradually
    "noImplicitAny": false,       // Temporarily disabled for build success - will re-enable gradually
    "strictBindCallApply": true,  // Phase 3: Enabled for function binding safety
    "strictFunctionTypes": true,  // Phase 3: Enabled for function type safety
    "strictPropertyInitialization": false, // Keep disabled for now (DTO classes)
    
    // Code quality options
    "forceConsistentCasingInFileNames": true,  // Phase 3: Enabled for consistency
    "noFallthroughCasesInSwitch": true,        // Phase 3: Enabled to prevent bugs
    "noImplicitReturns": false,                // Temporarily disabled for build success
    "noUnusedLocals": false,                   // Keep disabled for development flexibility
    "noUnusedParameters": false,               // Keep disabled for callback patterns
    
    // Additional helpful options
    "exactOptionalPropertyTypes": false,       // Keep disabled for DTO flexibility
    "noImplicitOverride": false,              // Temporarily disabled for build success
    "noPropertyAccessFromIndexSignature": false, // Keep disabled for dynamic access
    "noUncheckedIndexedAccess": false,        // Keep disabled for array/object access patterns
    
    // Import/Export options
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    
    // Path mapping for clean imports
    "paths": {
      "@/*": ["src/*"],
      "@/modules/*": ["src/modules/*"],
      "@/common/*": ["src/common/*"],
      "@/enums/*": ["src/enums/*"]
    }
  },
  
  // Include/Exclude patterns
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/test-utils/**/*",
    "fix-*.js"
  ]
}
